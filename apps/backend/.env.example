PORT=3000

# STORAGE_DRIVER=memory — данные хранятся в процессе и сбрасываются при
# перезапуске (удобно для тестов/быстрого старта без БД).
# STORAGE_DRIVER=postgres — данные хранятся в PostgreSQL (см. docker-compose.yml
# в корне репозитория для локального запуска БД).
STORAGE_DRIVER=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=scheduling
DB_PASSWORD=scheduling
DB_NAME=scheduling
