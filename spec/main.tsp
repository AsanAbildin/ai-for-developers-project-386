import "@typespec/http";
import "@typespec/rest";
import "@typespec/openapi3";
import "./models.tsp";
import "./event-types.tsp";
import "./bookings.tsp";

using TypeSpec.Http;

/**
 * Scheduling API — сервис бронирования встреч по типам событий.
 *
 * Роли:
 * - Владелец календаря: единственный предзаданный профиль, управляет
 *   типами событий (EventType) и видит список всех бронирований.
 * - Гость: без аккаунта, просматривает типы событий, свободные слоты
 *   на 14 дней вперёд и создаёт/отменяет свои бронирования.
 *
 * Авторизация в проекте отсутствует. Разделение на "владельца" и
 * "гостя" в этой спецификации — логическое (для документации намерений
 * эндпоинтов); фактическое ограничение доступа к owner-эндпоинтам
 * реализуется на уровне приложения (например, единственный админ-роут
 * без публичной ссылки).
 */
@service({ title: "Scheduling API" })
namespace SchedulingApi {}
